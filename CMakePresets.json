{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 18,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "cuda-release",
            "displayName": "CUDA Release",
            "description": "NVIDIA CUDA — optimized build",
            "inherits": "base",
            "cacheVariables": {
                "USE_CUDA": "ON",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "cuda-debug",
            "displayName": "CUDA Debug",
            "description": "NVIDIA CUDA — debug build with sanitizers",
            "inherits": "base",
            "cacheVariables": {
                "USE_CUDA": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "cuda-release-tests",
            "displayName": "CUDA Release + Tests",
            "description": "NVIDIA CUDA — optimized build with tests enabled",
            "inherits": "cuda-release",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "description": "Windows MSVC — optimized build",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "cacheVariables": {
                "USE_CUDA": "ON",
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cuda-release",
            "configurePreset": "cuda-release",
            "configuration": "Release"
        },
        {
            "name": "cuda-debug",
            "configurePreset": "cuda-debug",
            "configuration": "Debug"
        },
        {
            "name": "cuda-release-tests",
            "configurePreset": "cuda-release-tests",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "cuda-tests",
            "configurePreset": "cuda-release-tests",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
